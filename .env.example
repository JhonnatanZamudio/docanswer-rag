# Offline by default: no API keys needed.
LLM_PROVIDER=extractive        # extractive | anthropic | openai
LLM_MODEL=                     # e.g. claude-sonnet-4-5 or gpt-4o-mini
EMBEDDER=tfidf                 # tfidf | openai | none
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small

TOP_K=5
REFUSAL_THRESHOLD=0.47         # calibrated with `make calibrate` on eval/dev_questions.jsonl
CHUNK_MAX_WORDS=90
CHUNK_OVERLAP_SENTENCES=1
DOCS_DIR=data/docs
INDEX_DIR=data/index
INGEST_TOKEN=                  # if set, POST /ingest requires header X-Ingest-Token
